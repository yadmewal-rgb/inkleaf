// Inkleaf sync service. Cloudflare builds this folder when it is connected to the GitHub repo
// (Workers > Create > Import a repository, root directory "server").
// Set in the Cloudflare dashboard as secrets, never here: ALLOWED (allowed e-mail addresses, comma separated)
// and GOOGLE_SECRET (the client secret of Inkleaf's Google OAuth client, so files can be kept in each person's Drive).
// QUOTA_MB: each person's share of Cloudflare storage.
{
  "name": "inkleaf-sync",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "USER", "class_name": "User" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["User"] }],
  "vars": {
    "ORIGINS": "https://yadmewal-rgb.github.io,http://localhost:8080",
    "QUOTA_MB": "500"
  }
}
